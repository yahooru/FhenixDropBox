# Public frontend config
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ENABLE_RESUMABLE_UPLOADS=false

# RPC endpoints
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployment wallets
# Keep real private keys only in .env.local or your Vercel environment.
PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
RELAYER_ALLOWED_OWNERS=

# Explorers
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Pinata
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# App and webhook runtime
APP_BASE_URL=http://localhost:3000
WEBHOOK_DELIVERY_TARGETS=[]
WEBHOOK_DELIVERY_SECRET=
WEBHOOK_BLOCK_WINDOW=5000
WEBHOOK_CHECKPOINT_FILE=.webhook-checkpoints.json
WEBHOOK_TARGETS_FILE=.webhook-targets.json
ANALYTICS_BLOCK_WINDOW=10000
RESUMABLE_UPLOAD_DIR=
