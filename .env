# Environment Variables for FhenixDropBox
# Do not put real secrets in this tracked file. Use .env.local for local keys.

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC URLs
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private Key (for deployment, local only)
PRIVATE_KEY=

# Smart Contract Address. Use .env.local for the active deployment.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Pinata IPFS API (for file uploads, local only)

# Webhook worker auth (local only)
WEBHOOK_DELIVERY_SECRET=
WEBHOOK_CHECKPOINT_FILE=.webhook-checkpoints.json
WEBHOOK_TARGETS_FILE=.webhook-targets.json
NEXT_PUBLIC_ENABLE_RESUMABLE_UPLOADS=false
RESUMABLE_UPLOAD_DIR=

